# --- Betrieb --------------------------------------------------------------
HTTP_PORT=8080
# Optional: Bearer-Token für HTTP. Leer = offen. /health bleibt immer offen.
MCP_AUTH_TOKEN=
# Demo/REST ausliefern (false = nur /mcp und /health)
WEB_ENABLED=true
# PUBLIC_URL=

# --- Lexikon --------------------------------------------------------------
# Image default: fixture. Production: absolute path inside container / volume.
NAMELEX_DB_PATH=data/fixtures/surnames.sqlite3
NAMELEX_GIVEN_DB_PATH=data/fixtures/given-names.sqlite3
# NAMELEX_DB_PATH=/data/names.sqlite3
NAMELEX_MATCH_LIMIT=5
NAMELEX_SIMILARITY_THRESHOLD=0.86
