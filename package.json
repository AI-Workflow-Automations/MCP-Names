{
  "name": "mcp-names",
  "version": "0.1.0",
  "description": "MCP server for German surname hydration via Namelex",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.10.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "inspect": "pnpm dlx @modelcontextprotocol/inspector bun run src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@12.4.1"
}
